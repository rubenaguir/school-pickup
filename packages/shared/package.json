{
  "name": "@casillego/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./entities": {
      "types": "./dist/cjs/entities/index.d.ts",
      "default": "./dist/cjs/entities/index.js"
    },
    "./pickup-request-transition": {
      "types": "./dist/cjs/pickup-request-transition.d.ts",
      "default": "./dist/cjs/pickup-request-transition.js"
    }
  },
  "typesVersions": {
    "*": {
      "entities": [
        "./dist/cjs/entities/index.d.ts"
      ],
      "pickup-request-transition": [
        "./dist/cjs/pickup-request-transition.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ./scripts/write-esm-marker.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  }
}
