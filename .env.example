# ---- API ----
API_PORT=3000
NODE_ENV=development
# Origenes permitidos por CORS, separados por comas (ADR-043 pt.1). En
# desarrollo son los 3 servidores de Vite: portal / parent / board. En
# produccion se sirve todo desde el mismo origen tras nginx, asi que se deja
# vacio y el middleware ni siquiera se registra.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Database (PostgreSQL + PostGIS) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=casillego
DB_PASSWORD=casillego
DB_NAME=casillego
# Cadena de conexion completa (alternativa a los campos de arriba)
DATABASE_URL=postgres://casillego:casillego@localhost:5432/casillego

# ---- MQTT (Mosquitto) ----
# Broker compartido: todos los topics cuelgan del prefijo raiz "school-pickup/"
MQTT_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:9001
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACTIVATION_SECRET=change-me-activation
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Token de activacion de cuenta (verificacion de correo, y a futuro
# aceptacion de invitaciones) - JWT de corta duracion, sin persistencia (ADR-019 pt.2, ADR-022 pt.3)
JWT_ACTIVATION_TTL=86400

# ---- Email (Resend, ver ADR-009) ----
EMAIL_PROVIDER=console
RESEND_API_KEY=
PARENT_APP_URL=https://app.casillego.com.mx
PORTAL_APP_URL=https://portal.casillego.com.mx

# ---- Maps (worker, ETA por Mapbox Directions API, ver ADR-061) ----
# Sin MAPS_PROVIDER=mapbox el worker usa StubMapsProvider (haversine), igual
# que hasta ahora. Token propio del worker, no compartido con VITE_MAPBOX_TOKEN.
MAPS_PROVIDER=stub
MAPBOX_ACCESS_TOKEN=

# ---- Web Push (notificacion de confirmacion de entrega, ver ADR-066) ----
# Par de llaves VAPID generado una sola vez (`npx web-push generate-vapid-keys`).
# apps/api las carga desde este .env raiz, mismo mecanismo que MAPBOX_ACCESS_TOKEN.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Siembra del super-admin (solo desarrollo, ver README) ----
# Las lee `npm run seed:super-admin -w @casillego/api`; no las usa la API en
# tiempo de ejecucion. El super-admin no tiene flujo de alta propio (ADR-038).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Super Admin
