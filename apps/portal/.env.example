# Raiz de la API, incluyendo su prefijo global /api.
# Vite lee este archivo desde apps/portal, no desde la raiz del monorepo.
# El origen debe estar en CORS_ORIGINS de la API (ver .env.example raiz, ADR-043).
VITE_API_BASE_URL=http://localhost:3000/api

# Token publico de Mapbox para el mapa de geocerca (ADR-048 punto 3).
# No es un secreto en el sentido clasico -- viaja al navegador -- pero DEBE
# restringirse por URL permitida desde el panel de Mapbox, o cualquiera puede
# gastar la cuota desde otro dominio. Sin el, la pantalla de perfil muestra un
# panel explicativo en lugar del mapa.
VITE_MAPBOX_TOKEN=

# URL de apps/board (tablero de institucion), para el boton "Abrir tablero"
# del Dashboard (ADR-072 punto 6). No existia ningun enlace resuelto en el
# resto del portal hacia apps/board -- sin este valor el boton queda visible
# pero deshabilitado (mismo criterio que ADR-034/035), en vez de enlazar a
# una URL adivinada.
VITE_BOARD_URL=
