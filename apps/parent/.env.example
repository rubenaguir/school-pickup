# Raiz de la API, incluyendo su prefijo global /api.
# Vite lee este archivo desde apps/parent, no desde la raiz del monorepo.
# El origen debe estar en CORS_ORIGINS de la API (ver .env.example raiz, ADR-043).
VITE_API_BASE_URL=http://localhost:3000/api

# Token publico de Mapbox para el mapa de la pantalla de seguimiento (ADR-048
# punto 3, ADR-064). No es un secreto en el sentido clasico -- viaja al
# navegador -- pero DEBE restringirse por URL permitida desde el panel de
# Mapbox, o cualquiera puede gastar la cuota desde otro dominio. Sin el, la
# pantalla de seguimiento muestra un panel explicativo en lugar del mapa.
VITE_MAPBOX_TOKEN=
