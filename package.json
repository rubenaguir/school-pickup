{
  "name": "casillego",
  "version": "0.0.0",
  "private": true,
  "description": "CasiLlego — plataforma SaaS multi-tenant para reducir filas de coches en la salida de instituciones.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @casillego/shared",
    "dev:api": "npm run start:dev -w @casillego/api",
    "dev:worker": "npm run start:dev -w @casillego/worker",
    "dev:portal": "npm run dev -w @casillego/portal",
    "dev:parent": "npm run dev -w @casillego/parent",
    "dev:board": "npm run dev -w @casillego/board"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
